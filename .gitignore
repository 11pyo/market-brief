# 비밀·환경
.env
.env.*
*.bak
.claude/
.omc/
server.log

# 로그 (실행 로그에는 오류 상세가 담긴다)
logs/

# 빌드 결과 (gh-pages 브랜치로 배포되므로 master에는 두지 않는다)
# 반드시 선행 슬래시를 붙인다: `site/` 는 하위 경로의 같은 이름 디렉터리(mbrief/site/ = 사이트 빌더
# 패키지)까지 제외해 버려, 새로 clone 하면 build 명령이 ImportError 로 죽는다.
/site/

# 런타임 데이터
# 시세·차트 스냅샷 (재생성 가능)
data/cache/
# 생성된 브리핑 레코드 (portfolioNote 원본 포함 - 절대 커밋 금지, 공개본은 gh-pages로 배포)
data/briefings/
# 소유자 포트폴리오 (비공개)
data/portfolio.json
# 예시 파일은 실제 보유 내역이 아니므로 커밋한다 (복사해서 쓰는 템플릿)
!data/portfolio.example.json
# 섹터 PER/PBR 일별 기록 (append-only). 매일 한 줄씩 쌓이는 런타임 데이터라 커밋하지 않는다.
# 사이트 빌드가 site/data/ 로 복사해 배포하므로 유실되어도 배포본에서 되살릴 수 있다.
data/valuation/
data/scorecard.json
data/.daily.lock
data/stats.json
data/settings.json

# Node (wrangler - Cloudflare Pages 배포용)
node_modules/

# 파이썬
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# 프로젝트와 무관한 로컬 문서
PrimeSteel_*.md
SAP_Screenshots/
