# ==============================================================================
#  MarketBrief v2 설정 예시
#  이 파일을 .env 로 복사한 뒤 값을 채운다.  (.env 는 절대 커밋하지 않는다)
#      copy .env.example .env
#  모든 항목에 기본값이 있으므로, 아무것도 설정하지 않아도 동작한다.
# ==============================================================================


# ------------------------------------------------------------------------------
#  1. LLM — 로컬 Claude Code CLI (1순위, 권장)
# ------------------------------------------------------------------------------
#  API 키가 아니라 **구독 요금제(Pro/Max) 쿼터**를 사용한다.
#  사전 준비 (딱 한 번):
#      claude auth login
#  토큰이 만료·폐기되면 `claude -p` 가 401을 반환한다. 같은 명령으로 재로그인하면 된다.
#  진단:  python -m mbrief doctor

CLAUDE_CLI_ENABLED=true
# 비우면 PATH에서 claude 를 자동 탐색한다.
# npm 전역 설치의 .cmd shim 대신 같은 트리의 실제 claude.exe 를 자동으로 우선 사용한다.
CLAUDE_CLI_PATH=
# 모델 정책: Claude 호출은 **최소 sonnet** 이다. haiku 는 브리핑 품질(수치·실명 추출)이 떨어져
# 허용 목록에서 제외했다. haiku 를 넣으면 경고와 함께 sonnet 으로 강등된다 (전체 모델 ID 도 동일).
# sonnet | opus | fable | claude-<모델ID>  (그 외 값은 무시되고 sonnet 으로 대체된다)
CLAUDE_CLI_MODEL=sonnet
# 과부하 시 CLI 자체 폴백(--fallback-model). 비우면 사용하지 않는다.
# 구독 쿼터 안에서 생성을 이어가기 위해 sonnet 과부하 시 opus 로 넘긴다.
CLAUDE_CLI_FALLBACK_MODEL=opus
# 1회 호출 상한(초). 구조화 출력 한국어 브리핑 실측 4~7분.
CLAUDE_CLI_TIMEOUT_SEC=720
# 실패 시 재시도 횟수. 인증 실패는 재시도하지 않는다.
CLAUDE_CLI_RETRIES=1
# 추가 언어 번역 패스용 모델 (분석을 다시 하지 않는 가벼운 패스지만 최소 sonnet 정책을 지킨다)
CLAUDE_CLI_TRANSLATE_MODEL=sonnet


# ------------------------------------------------------------------------------
#  2. LLM — API 폴백 (선택)
# ------------------------------------------------------------------------------
#  claude CLI 가 실패했을 때(미로그인 포함)만 사용한다. openai/gemini 는 같은 JSON 스키마로
#  **구조화 출력**을 요청하며(사이트가 파트별 컴포넌트를 그대로 렌더한다), 모델이 스키마를 거부하면
#  스키마 없이 1회 재시도해 마크다운으로 폴백한다. anthropic 은 텍스트 전용이다.
#  나열한 순서대로 시도하고, 키가 없는 프로바이더는 자동 제외된다.
#  로컬 CLI를 쓰지 못하면 그 사실이 콘솔·로그·텔레그램 알림에 안내로 출력된다.
#  주의: 폴백을 켜면 수집한 뉴스 본문이 외부 API로 전송된다.
#        (포트폴리오는 어떤 설정에서도 외부 API로 보내지 않는다 — 로컬 CLI 경로 전용)

LLM_FALLBACK_PROVIDERS=openai,gemini   # 순서대로 시도. 지원: openai,gemini,anthropic (빈 값이면 폴백 없음)
LLM_TIMEOUT_SEC=300                # 프로바이더 1회 호출 상한(초)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Messages API (종량 과금). 위의 CLAUDE_CLI 구독 경로와는 별개다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5


# ------------------------------------------------------------------------------
#  3. 데이터 소스
# ------------------------------------------------------------------------------
#  Finnhub 무료 키 (https://finnhub.io) — 기업 뉴스와 어닝 캘린더에 사용.
#  비워 두면 RSS(중앙은행·통신사·와이어)만으로 수집하며 파이프라인은 정상 동작한다.
#  키는 X-Finnhub-Token 헤더로만 전송되므로 로그에 남지 않는다.
#  시세(yfinance), FOMC 일정(Fed), 지표 결과(BLS), 공포탐욕(CNN)은 키가 필요 없다.
FINNHUB_API_KEY=


# ------------------------------------------------------------------------------
#  4. 브리핑
# ------------------------------------------------------------------------------
# 쉼표 구분. 첫 언어로 분석을 생성하고 나머지는 번역 패스로 만든다. (ko | en | zh | ja)
BRIEFING_LANGS=ko
# daily 명령이 실제로 실행되는 요일 (mon~sun). 미국 증시 기준이라 일요일은 기본 제외.
BRIEFING_DAYS=mon,tue,wed,thu,fri,sat
# 정적 사이트에 포함할 최근 브리핑 수 (data/briefings/ 에는 전부 보관된다)
MAX_BRIEFINGS_ON_SITE=60
# PART 8(소유자 포트폴리오 맞춤 조언)을 공개 사이트에 포함할지.
# data/portfolio.json 이 있으면 조언은 생성되지만, 이 값이 false면 공개 출력에서 제외된다.
# 비공개 상태로도 `python -m mbrief show --private` 로 본인만 확인할 수 있다.
# 예시 파일: data/portfolio.example.json 을 data/portfolio.json 으로 복사해 값을 채운다.
PUBLISH_PORTFOLIO_NOTE=false
TZ=Asia/Seoul


# ------------------------------------------------------------------------------
#  5. 정적 사이트
# ------------------------------------------------------------------------------
# 공개 URL. canonical/sitemap/feed/텔레그램 링크에 사용한다. 끝에 / 를 붙이지 않는다.
# GitHub 프로젝트 페이지 예시:
SITE_URL=https://11pyo.github.io/market-brief-ai
SITE_NAME=증시흐름
SITE_TITLE=AI 모닝 마켓 브리핑 | 증시흐름
SITE_DESCRIPTION=매일 아침 07시, 로컬 Claude가 글로벌 뉴스와 시세를 분석해 만드는 헤지펀드 모닝노트 스타일 브리핑.
GITHUB_REPO_URL=https://github.com/11pyo/market-brief-ai


# ------------------------------------------------------------------------------
#  6. 배포
# ------------------------------------------------------------------------------
PUBLISH_ENABLED=true

# github     = gh-pages 브랜치로 푸시. 무료 플랜은 '공개 저장소'여야 Pages가 동작한다.
# cloudflare = Cloudflare Pages Direct Upload. 저장소가 필요 없어 소스를 비공개로 둘 수 있고
#              대역폭 제한이 없다. 사전 준비: `npx wrangler login` 1회 실행.
PUBLISH_TARGET=github

# --- PUBLISH_TARGET=github 일 때 ---
# 리모트 '이름'(예: origin) 또는 저장소 URL.
#       소스 저장소가 비공개라면 배포 전용 공개 저장소의 URL을 여기에 지정한다.
# 인증은 OS 의 git credential helper 에 위임한다.
# 토큰이 포함된 URL(https://user:TOKEN@github.com/...)을 여기에 직접 넣으면 .env 평문에 남는다.
PUBLISH_REMOTE=origin
PUBLISH_BRANCH=gh-pages

# --- PUBLISH_TARGET=cloudflare 일 때 ---
# Pages 프로젝트명 (소문자·숫자·하이픈, 54자 이내). 없으면 최초 배포 시 자동 생성한다.
CLOUDFLARE_PROJECT=
# 아래 둘은 '무인 실행'용이다. 비워 두면 `wrangler login` 세션을 사용한다.
# 작업 스케줄러로 매일 돌릴 때는 토큰 방식이 안정적이다.
# 토큰 생성: Cloudflare 대시보드 → My Profile → API Tokens → Create Token
#           → 템플릿 대신 Custom: Account / Cloudflare Pages / Edit 권한만 부여
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=


# ------------------------------------------------------------------------------
#  7. 알림 (선택)
# ------------------------------------------------------------------------------
#  둘 다 설정된 경우에만 전송한다. 하나라도 비면 조용히 건너뛴다.
#  봇 생성: 텔레그램에서 @BotFather → /newbot
#  챗 ID  : 봇에게 아무 메시지나 보낸 뒤
#           https://api.telegram.org/bot<TOKEN>/getUpdates 의 result[].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ==============================================================================
# Security Checklist
# Applied:
#   - Hard-coded Credentials: 모든 키·토큰을 소스가 아닌 이 설정 파일(환경변수)로 분리
#   - Unencrypted Sensitive Data: Finnhub 키는 쿼리스트링이 아닌 요청 헤더로 전송됨을 명시
#   - Improper Authorization: PUBLISH_PORTFOLIO_NOTE 기본값 false 로 비공개 조언의 공개를 차단
#   - Improper Input for Security Decision: 모델·언어·요일 값은 코드에서 화이트리스트 검증 후 사용
# Not Applied:
#   - [WARN] .env 는 평문이다. OS 사용자 권한으로만 보호되므로 공용 PC에서는 사용하지 말 것.
#   - [WARN] 이 예시 파일에는 실제 값을 절대 채워 넣지 말 것 (.env.example 은 저장소에 커밋된다).
# ==============================================================================
